{
  "name": "laostay-backend",
  "version": "0.1.0",
  "description": "LaoStay API — serves WebAdmin, Partner app and Customer app",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "db:migrate": "node scripts/run-migration.mjs",
