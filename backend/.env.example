# LaoStay backend — copy to .env and fill in.
#
#   cp .env.example .env
#
# Only DATABASE_URL and the two JWT secrets have no workable default. Everything
# else runs out of the box in development.

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL 15+ with PostGIS. The project runs on Neon; any Postgres with the
# postgis extension available will do.
#
# Note the pooled Neon host: `SELECT … FOR UPDATE` in the booking path holds
# locks for the length of a transaction, so a direct (unpooled) connection is
# the wrong choice under load.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# DIRECT_URL bypasses the pooler — used by `prisma migrate`/`db push` only,
# since PgBouncer's transaction pooling breaks migration locks/prepared
# statements. Same host as above, minus the `-pooler` suffix.
DIRECT_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Server ──────────────────────────────────────────────────────────────────
# 3100 rather than 3000, which is often taken by something else on a dev box.
# Changing it means changing the proxy target in webadmin/vite.config.ts and
# webapp/vite.config.ts too.
PORT=3100

# development | production
# `production` is load-bearing: it silences the dev-only OTP and password-reset
# codes in API responses, refuses the dev payment-settle route, and makes
# `db:reset` refuse to run at all.
NODE_ENV=development

# Comma-separated. The admin panel, the guest web app, and the partner app on
# Chrome (`flutter run -d chrome --web-port 5175`) are separate origins.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate real ones — these are what stand between a stranger and every
# account on the platform:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# The two must differ. A single secret would let a refresh token be presented
# as an access token.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Fallbacks only — `system_settings` overrides both at runtime.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Payments ────────────────────────────────────────────────────────────────
# simulated | phajay
#
# `simulated` signs its own callbacks so the booking flow is testable end to
# end without an acquirer. Selecting it under NODE_ENV=production logs a loud
# error at boot — no real money would move.
PAYMENT_PROVIDER=simulated

# Required when PAYMENT_PROVIDER=phajay. PhaJay issues ONE key that covers
# everything; it is sent as the `secretKey` header. Use the test key until KYC.
PHAJAY_API_KEY=

# Which bank's QR the guest is shown. The QR is not interchangeable between
# banks — a BCEL payload is read by the BCEL app — so this picks the one most
# of your guests carry.  bcel · jdb · ldb · ib · stb · m_money
PHAJAY_BANK=bcel

# PhaJay signs nothing on their callback, so the secret lives in the URL they
# call. Generate one with `openssl rand -hex 32`, then register
#   https://<host>/api/payments/phajay/webhook/<this value>
# in the PhaJay portal under Settings > Webhook Setting. Without it every
# callback is refused — a guest who knows their own booking code and total
# could otherwise confirm a stay they never paid for.
PHAJAY_WEBHOOK_SECRET=

# The gateway host.
PHAJAY_BASE_URL=https://payment-gateway.phajay.co

# How long a QR is offered before the guest has to ask for a new one.
PHAJAY_QR_TTL_MIN=15

# The simulator mints its own QR from these; PhaJay's real QR carries its own
# merchant details, so they are only read when PAYMENT_PROVIDER=simulated.
PHAJAY_MERCHANT_ID=SIMULATED-MERCHANT

# ── Demo data ───────────────────────────────────────────────────────────────
# The password every seeded admin gets from `npm run db:reset -- --yes`.
SEED_ADMIN_PASSWORD=LaoStay@2026

# ── Not wired up yet ────────────────────────────────────────────────────────
# There is no SMS or email provider. OTP codes and password-reset tokens are
# generated and stored, and outside production they come back in the response
# so the flow is testable — but nothing sends them. In production both flows
# are therefore dead ends. See the plan's P0-2.
#
# SMS_PROVIDER=console
# EMAIL_PROVIDER=console
#
# ── Photo storage ────────────────────────────────────────────────────────────
# 'local'  photos go to backend/uploads/ and this process serves them. Fine on
#          one VPS with a persistent volume; the folder must be backed up too,
#          because a database dump does not contain it.
# 'r2'     any S3-compatible bucket — Cloudflare R2, AWS S3, MinIO. Required
#          once more than one instance runs, or when the disk is ephemeral.
#
# Setting r2 with any S3_* key missing stops the process at boot rather than
# quietly writing to local disk.
STORAGE_PROVIDER=local

# Cloudflare R2: create a bucket, then an API token with Object Read & Write.
#   S3_ENDPOINT    https://<account-id>.r2.cloudflarestorage.com
#   S3_PUBLIC_URL  the bucket's public domain — either the r2.dev address, or
#                  a custom hostname pointed at it. This is what gets written
#                  into the database, so changing it later leaves old rows
#                  pointing at the old host.
#   S3_REGION      'auto' for R2; a real region for AWS.
#
# S3_ENDPOINT=https://xxxxxxxx.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=laostay-photos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
