generator client {
  provider = "prisma-client-js"

  // Lets a query with `include` be answered by one SQL statement with LATERAL
  // joins instead of one round trip per relation. On a database 41ms away that
  // is the difference between 800ms and 90ms for the property page, which has
  // ten nested includes and was paying the latency ten times over.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public"]
}

model app_settings {
  setting_id    BigInt   @id @default(autoincrement())
  setting_key   String   @unique @db.VarChar(120)
  setting_value String?
  description   String?  @db.VarChar(255)
  updated_by    BigInt?
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
  admins        users?   @relation(fields: [updated_by], references: [user_id], onUpdate: NoAction)

  @@index([updated_by], map: "idx_app_settings_updater")
  @@schema("public")
}

model audit_logs {
  audit_log_id BigInt   @id @default(autoincrement())
  user_id      BigInt?
  action       String   @db.VarChar(120)
  module_name  String?  @db.VarChar(80)
  table_name   String?  @db.VarChar(80)
  record_id    BigInt?
  old_values   Json?
  new_values   Json?
  ip_address   String?  @db.VarChar(64)
  user_agent   String?  @db.VarChar(500)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  users        users?   @relation(fields: [user_id], references: [user_id], onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_audit_logs_created")
  @@index([table_name, record_id], map: "idx_audit_logs_record")
  @@index([user_id, created_at(sort: Desc)], map: "idx_audit_logs_user")
  @@schema("public")
}

model booking_items {
  booking_item_id BigInt     @id @default(autoincrement())
  booking_id      BigInt
  room_type_id    BigInt
  quantity        Int        @default(1)
  nights          Int
  price_per_night BigInt
  subtotal        BigInt
  created_at      DateTime   @default(now()) @db.Timestamptz(6)
  bookings        bookings   @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade, onUpdate: NoAction)
  room_types      room_types @relation(fields: [room_type_id], references: [room_type_id], onUpdate: NoAction)

  @@index([booking_id], map: "idx_booking_items_booking")
  @@index([room_type_id], map: "idx_booking_items_room_type")
  @@schema("public")
}

model bookings {
  booking_id             BigInt                 @id @default(autoincrement())
  booking_code           String                 @unique @db.VarChar(32)
  customer_id            BigInt
  property_id            BigInt
  cancellation_policy_id BigInt?
  source                 booking_source         @default(app)
  check_in               DateTime               @db.Date
  check_out              DateTime               @db.Date
  nights                 Int
  total_guests           Int                    @default(1)
  subtotal_amount        BigInt                 @default(0)
  discount_amount        BigInt                 @default(0)
  tax_amount             BigInt                 @default(0)
  service_fee            BigInt                 @default(0)
  cleaning_fee           BigInt                 @default(0)
  commission_rate        Decimal                @default(0) @db.Decimal(5, 2)
  commission_amount      BigInt                 @default(0)
  total_amount           BigInt                 @default(0)
  payout_amount          BigInt                 @default(0)
  currency               String                 @default("LAK") @db.Char(3)
  status                 booking_status         @default(pending)
  hold_expires_at        DateTime?              @db.Timestamptz(6)
  special_request        String?
  idempotency_key        String?                @unique @db.VarChar(255)
  deleted_at             DateTime?              @db.Timestamptz(6)
  created_at             DateTime               @default(now()) @db.Timestamptz(6)
  updated_at             DateTime               @default(now()) @db.Timestamptz(6)
  booking_cancellations  booking_cancellations?
  booking_guests         booking_guests[]
  booking_items          booking_items[]
  booking_status_logs    booking_status_logs[]
  cancellation_policies  cancellation_policies? @relation(fields: [cancellation_policy_id], references: [cancellation_policy_id], onUpdate: NoAction)
  users                  users                  @relation(fields: [customer_id], references: [user_id], onUpdate: NoAction)
  properties             properties             @relation(fields: [property_id], references: [property_id], onUpdate: NoAction)
  conversations          conversations[]
  coupon_usages          coupon_usages[]
  ledger_entries         ledger_entries[]
  payments               payments[]
  payout_items           payout_items[]
  refunds                refunds[]
  reviews                reviews?

  @@index([status, created_at(sort: Desc)], map: "idx_bookings_status_created")
  @@index([check_out], map: "idx_bookings_checkout")
  @@index([customer_id, status], map: "idx_bookings_customer_status")
  @@index([cancellation_policy_id], map: "idx_bookings_policy")
  @@index([property_id, check_in], map: "idx_bookings_property_checkin")
  @@schema("public")
}

model notifications {
  notification_id   BigInt            @id @default(autoincrement())
  user_id           BigInt
  title             String            @db.VarChar(255)
  message           String?
  notification_type notification_type @default(system)
  reference_type    String?           @db.VarChar(60)
  reference_id      BigInt?
  is_read           Boolean           @default(false)
  read_at           DateTime?         @db.Timestamptz(6)
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  users             users             @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, is_read, created_at(sort: Desc)], map: "idx_notifications_user")
  @@schema("public")
}

model partners {
  partner_id              BigInt                  @id @default(autoincrement())
  user_id                 BigInt                  @unique
  business_name           String                  @db.VarChar(255)
  business_type           business_type           @default(individual)
  tax_id                  String?                 @db.VarChar(100)
  contact_phone           String?                 @db.VarChar(50)
  default_commission_rate Decimal                 @default(5.00) @db.Decimal(5, 2)
  walkin_commission_rate  Decimal                 @default(2.50) @db.Decimal(5, 2)
  status                  partner_status          @default(pending)
  verified_at             DateTime?               @db.Timestamptz(6)
  deleted_at              DateTime?               @db.Timestamptz(6)
  created_at              DateTime                @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                @default(now()) @db.Timestamptz(6)
  ledger_entries          ledger_entries[]
  partner_bank_accounts   partner_bank_accounts[]
  partner_documents       partner_documents[]
  users                   users                   @relation(fields: [user_id], references: [user_id], onUpdate: NoAction)
  payouts                 payouts[]
  promotion_partners      promotion_partners[]
  properties              properties[]

  @@index([status], map: "idx_partners_status")
  @@schema("public")
}

model payments {
  payment_id      BigInt           @id @default(autoincrement())
  booking_id      BigInt
  payment_method  payment_method   @default(phajay_qr)
  idempotency_key String           @unique @db.VarChar(255)
  qr_payload      String?
  amount          BigInt
  status          payment_status   @default(pending)
  txn_ref         String?          @db.VarChar(120)
  paid_at         DateTime?        @db.Timestamptz(6)
  expired_at      DateTime?        @db.Timestamptz(6)
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @default(now()) @db.Timestamptz(6)
  payment_events  payment_events[]
  bookings        bookings         @relation(fields: [booking_id], references: [booking_id], onUpdate: NoAction)
  refunds         refunds[]

  @@index([txn_ref], map: "idx_payments_txn_ref")
  @@index([booking_id, status], map: "idx_payments_booking_status")
  @@schema("public")
}

model payouts {
  payout_id             BigInt                 @id @default(autoincrement())
  partner_id            BigInt
  bank_account_id       BigInt?
  period_start          DateTime               @db.Date
  period_end            DateTime               @db.Date
  gross_amount          BigInt                 @default(0)
  commission_amount     BigInt                 @default(0)
  net_amount            BigInt                 @default(0)
  status                payout_status          @default(pending)
  confirmed_by          BigInt?
  paid_at               DateTime?              @db.Timestamptz(6)
  created_at            DateTime               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime               @default(now()) @db.Timestamptz(6)
  payout_items          payout_items[]
  partner_bank_accounts partner_bank_accounts? @relation(fields: [bank_account_id], references: [bank_account_id], onUpdate: NoAction)
  users                 users?                 @relation(fields: [confirmed_by], references: [user_id], onUpdate: NoAction)
  partners              partners               @relation(fields: [partner_id], references: [partner_id], onUpdate: NoAction)

  @@index([partner_id, status], map: "idx_payouts_partner_status")
  @@index([period_start, period_end], map: "idx_payouts_period")
  @@index([bank_account_id], map: "idx_payouts_bank_account")
  @@index([confirmed_by], map: "idx_payouts_confirmer")
  @@schema("public")
}

model properties {
  property_id            BigInt                    @id @default(autoincrement())
  partner_id             BigInt
  cancellation_policy_id BigInt?
  property_name          String                    @db.VarChar(255)
  property_type          property_type
  description            String?
  phone                  String?                   @db.VarChar(50)
  email                  String?                   @db.VarChar(255)
  website                String?                   @db.VarChar(255)
  province_id            BigInt?
  district_id            BigInt?
  village_id             BigInt?
  address_detail         String?
  latitude               Decimal?                  @db.Decimal(10, 7)
  longitude              Decimal?                  @db.Decimal(11, 7)
  geog                   Unsupported("geography")? @default(dbgenerated("\nCASE\n    WHEN ((latitude IS NULL) OR (longitude IS NULL)) THEN NULL::geography\n    ELSE (st_setsrid(st_makepoint((longitude)::double precision, (latitude)::double precision), 4326))::geography\nEND"))
  search_vector          Unsupported("tsvector")?  @default(dbgenerated("to_tsvector('simple'::regconfig, (((COALESCE(property_name, ''::character varying))::text || ' '::text) || COALESCE(description, ''::text)))"))
  rating_avg             Decimal                   @default(0) @db.Decimal(3, 2)
  review_count           Int                       @default(0)
  status                 property_status           @default(draft)
  deleted_at             DateTime?                 @db.Timestamptz(6)
  created_at             DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                  @default(now()) @db.Timestamptz(6)
  bookings               bookings[]
  conversations          conversations[]
  promotion_properties   promotion_properties[]
  cancellation_policies  cancellation_policies?    @relation(fields: [cancellation_policy_id], references: [cancellation_policy_id], onUpdate: NoAction)
  districts              districts?                @relation(fields: [district_id], references: [district_id], onUpdate: NoAction)
  partners               partners                  @relation(fields: [partner_id], references: [partner_id], onUpdate: NoAction)
  provinces              provinces?                @relation(fields: [province_id], references: [province_id], onUpdate: NoAction)
  villages               villages?                 @relation(fields: [village_id], references: [village_id], onUpdate: NoAction)
  property_amenities     property_amenities[]
  property_images        property_images[]
  property_rules         property_rules?
  reviews                reviews[]
  room_types             room_types[]
  wishlist_items         wishlist_items[]

  @@index([partner_id], map: "idx_properties_partner")
  @@index([province_id], map: "idx_properties_province")
  @@index([district_id], map: "idx_properties_district")
  @@index([geog], map: "idx_properties_geog", type: Gist)
  @@index([cancellation_policy_id], map: "idx_properties_policy")
  @@index([search_vector], map: "idx_properties_search", type: Gin)
  @@index([property_type, status], map: "idx_properties_type_status")
  @@index([village_id], map: "idx_properties_village")
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reviews {
  review_id          BigInt           @id @default(autoincrement())
  booking_id         BigInt           @unique
  customer_id        BigInt
  property_id        BigInt
  overall_rating     Decimal          @db.Decimal(2, 1)
  cleanliness_rating Int?
  service_rating     Int?
  value_rating       Int?
  title              String?          @db.VarChar(255)
  comment            String?
  status             review_status    @default(published)
  created_at         DateTime         @default(now()) @db.Timestamptz(6)
  updated_at         DateTime         @default(now()) @db.Timestamptz(6)
  review_images      review_images[]
  review_replies     review_replies[]
  review_reports     review_reports[]
  bookings           bookings         @relation(fields: [booking_id], references: [booking_id], onUpdate: NoAction)
  users              users            @relation(fields: [customer_id], references: [user_id], onUpdate: NoAction)
  properties         properties       @relation(fields: [property_id], references: [property_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([customer_id], map: "idx_reviews_customer")
  @@index([property_id, status], map: "idx_reviews_property_status")
  @@schema("public")
}

model users {
  user_id                                          BigInt                  @id @default(autoincrement())
  role                                             user_role               @default(CUSTOMER)
  admin_role                                       admin_role?
  email                                            String                  @unique @db.VarChar(255)
  phone                                            String?                 @db.VarChar(50)
  password_hash                                    String                  @db.VarChar(255)
  status                                           user_status             @default(active)
  is_verified                                      Boolean                 @default(false)
  last_login_at                                    DateTime?               @db.Timestamptz(6)
  deleted_at                                       DateTime?               @db.Timestamptz(6)
  created_at                                       DateTime                @default(now()) @db.Timestamptz(6)
  updated_at                                       DateTime                @default(now()) @db.Timestamptz(6)
  announcements                                    announcements[]
  app_pages                                        app_pages[]
  app_settings                                     app_settings[]
  audit_logs                                       audit_logs[]
  banners                                          banners[]
  booking_cancellations                            booking_cancellations[]
  booking_status_logs                              booking_status_logs[]
  bookings                                         bookings[]
  conversation_reads                               conversation_reads[]
  conversations                                    conversations[]
  coupon_usages                                    coupon_usages[]
  coupons                                          coupons[]
  faqs                                             faqs[]
  messages                                         messages[]
  notifications                                    notifications[]
  otp_verifications                                otp_verifications[]
  partner_documents                                partner_documents[]
  partners                                         partners?
  password_reset_tokens                            password_reset_tokens[]
  payouts                                          payouts[]
  promotions                                       promotions[]
  refunds                                          refunds[]
  review_replies                                   review_replies[]
  review_reports_review_reports_handled_byTousers  review_reports[]        @relation("review_reports_handled_byTousers")
  review_reports_review_reports_reported_byTousers review_reports[]        @relation("review_reports_reported_byTousers")
  reviews                                          reviews[]
  system_settings                                  system_settings[]
  user_agreements                                  user_agreements[]
  user_device_tokens                               user_device_tokens[]
  user_profiles                                    user_profiles?
  user_sessions                                    user_sessions[]
  wishlist_items                                   wishlist_items[]

  @@index([phone], map: "idx_users_phone")
  @@index([role, status], map: "idx_users_role_status")
  @@schema("public")
}

model amenities {
  amenity_id         BigInt               @id @default(autoincrement())
  amenity_name_lo    String               @db.VarChar(120)
  amenity_name_en    String               @db.VarChar(120)
  icon               String?              @db.VarChar(80)
  category           String?              @db.VarChar(60)
  status             active_status        @default(active)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  property_amenities property_amenities[]

  @@schema("public")
}

model announcements {
  announcement_id  BigInt           @id @default(autoincrement())
  title            String           @db.VarChar(255)
  content          String?
  start_date       DateTime?        @db.Date
  end_date         DateTime?        @db.Date
  target_user_type target_user_type @default(ALL)
  is_active        Boolean          @default(true)
  created_by       BigInt?
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  updated_at       DateTime         @default(now()) @db.Timestamptz(6)
  users            users?           @relation(fields: [created_by], references: [user_id], onUpdate: NoAction)

  @@index([is_active, start_date, end_date], map: "idx_announcements_active")
  @@index([created_by], map: "idx_announcements_creator")
  @@schema("public")
}

model app_pages {
  page_id    BigInt   @id @default(autoincrement())
  page_slug  String   @unique @db.VarChar(120)
  title      String   @db.VarChar(255)
  content    String?
  is_active  Boolean  @default(true)
  updated_by BigInt?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  users      users?   @relation(fields: [updated_by], references: [user_id], onUpdate: NoAction)

  @@index([updated_by], map: "idx_app_pages_updater")
  @@schema("public")
}

model banners {
  banner_id     BigInt              @id @default(autoincrement())
  title         String              @db.VarChar(255)
  description   String?
  image_url     String?             @db.VarChar(500)
  target_type   banner_target_type?
  target_id     BigInt?
  display_order Int                 @default(0)
  start_date    DateTime?           @db.Date
  end_date      DateTime?           @db.Date
  is_active     Boolean             @default(true)
  created_by    BigInt?
  created_at    DateTime            @default(now()) @db.Timestamptz(6)
  updated_at    DateTime            @default(now()) @db.Timestamptz(6)
  users         users?              @relation(fields: [created_by], references: [user_id], onUpdate: NoAction)

  @@index([is_active, display_order], map: "idx_banners_active")
  @@index([created_by], map: "idx_banners_creator")
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model booking_cancellations {
  cancellation_id BigInt   @id @default(autoincrement())
  booking_id      BigInt   @unique
  cancelled_by    BigInt?
  reason          String?  @db.VarChar(255)
  policy_snapshot Json?
  penalty_amount  BigInt   @default(0)
  refund_amount   BigInt   @default(0)
  refund_id       BigInt?
  cancelled_at    DateTime @default(now()) @db.Timestamptz(6)
  bookings        bookings @relation(fields: [booking_id], references: [booking_id], onUpdate: NoAction)
  users           users?   @relation(fields: [cancelled_by], references: [user_id], onUpdate: NoAction)
  refunds         refunds? @relation(fields: [refund_id], references: [refund_id], onUpdate: NoAction)

  @@index([cancelled_by], map: "idx_booking_cancellations_actor")
  @@index([refund_id], map: "idx_booking_cancellations_refund")
  @@schema("public")
}

model booking_guests {
  guest_id   BigInt     @id @default(autoincrement())
  booking_id BigInt
  full_name  String     @db.VarChar(255)
  guest_type guest_type @default(adult)
  id_number  String?    @db.VarChar(255)
  is_primary Boolean    @default(false)
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  bookings   bookings   @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([booking_id], map: "idx_booking_guests_booking")
  @@schema("public")
}

model booking_status_logs {
  status_log_id BigInt          @id @default(autoincrement())
  booking_id    BigInt
  from_status   booking_status?
  to_status     booking_status
  changed_by    BigInt?
  note          String?         @db.VarChar(500)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  bookings      bookings        @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade, onUpdate: NoAction)
  users         users?          @relation(fields: [changed_by], references: [user_id], onUpdate: NoAction)

  @@index([changed_by], map: "idx_booking_status_logs_actor")
  @@index([booking_id, created_at(sort: Desc)], map: "idx_booking_status_logs_booking")
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cancellation_policies {
  cancellation_policy_id BigInt        @id @default(autoincrement())
  policy_name            String        @db.VarChar(120)
  days_before_checkin    Int           @default(0)
  penalty_percent        Decimal       @default(0) @db.Decimal(5, 2)
  is_refundable          Boolean       @default(true)
  description            String?
  status                 active_status @default(active)
  created_at             DateTime      @default(now()) @db.Timestamptz(6)
  updated_at             DateTime      @default(now()) @db.Timestamptz(6)
  bookings               bookings[]
  properties             properties[]

  @@schema("public")
}

model conversation_reads {
  conversation_read_id BigInt        @id @default(autoincrement())
  conversation_id      BigInt
  user_id              BigInt
  last_read_message_id BigInt?
  read_at              DateTime?     @db.Timestamptz(6)
  updated_at           DateTime      @default(now()) @db.Timestamptz(6)
  conversations        conversations @relation(fields: [conversation_id], references: [conversation_id], onDelete: Cascade, onUpdate: NoAction)
  messages             messages?     @relation(fields: [last_read_message_id], references: [message_id], onUpdate: NoAction)
  users                users         @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([conversation_id, user_id])
  @@index([last_read_message_id], map: "idx_conversation_reads_msg")
  @@index([user_id], map: "idx_conversation_reads_user")
  @@schema("public")
}

model conversations {
  conversation_id                                  BigInt               @id @default(autoincrement())
  customer_id                                      BigInt
  property_id                                      BigInt
  booking_id                                       BigInt?
  last_message_id                                  BigInt?
  last_message_at                                  DateTime?            @db.Timestamptz(6)
  status                                           conversation_status  @default(open)
  created_at                                       DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                                       DateTime             @default(now()) @db.Timestamptz(6)
  conversation_reads                               conversation_reads[]
  bookings                                         bookings?            @relation(fields: [booking_id], references: [booking_id], onUpdate: NoAction)
  users                                            users                @relation(fields: [customer_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  messages_conversations_last_message_idTomessages messages?            @relation("conversations_last_message_idTomessages", fields: [last_message_id], references: [message_id], onUpdate: NoAction, map: "conversations_last_message_fkey")
  properties                                       properties           @relation(fields: [property_id], references: [property_id], onDelete: Cascade, onUpdate: NoAction)
  messages_messages_conversation_idToconversations messages[]           @relation("messages_conversation_idToconversations")

  @@index([booking_id], map: "idx_conversations_booking")
  @@index([customer_id, last_message_at(sort: Desc)], map: "idx_conversations_customer")
  @@index([last_message_id], map: "idx_conversations_last_msg")
  @@index([property_id, last_message_at(sort: Desc)], map: "idx_conversations_property")
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model coupon_usages {
  usage_id        BigInt   @id @default(autoincrement())
  coupon_id       BigInt
  booking_id      BigInt
